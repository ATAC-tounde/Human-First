# Copiez en .env.local (jamais commité). Aucune clé IA requise.
PORT=4173
HOST=127.0.0.1
TRUST_PROXY=0
# Production et Vercel : variable d'environnement secrète obligatoire :
# HF_SESSION_SECRET : 64 caractères hexadécimaux aléatoires (32 octets).
# Génération locale Windows : node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# HF_SESSION_SECRET=NE_PAS_METTRE_UN_SECRET_DANS_GIT
# Sans cette variable, un serveur local de développement utilise une clé éphémère.